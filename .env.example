# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Security
SECRET_KEY=your-secret-key-here-change-this

# Database (for docker-compose, leave as is; for SQLite use: sqlite:///ctf.db)
DATABASE_URL=postgresql://ctf_user:ctf_password@db:5432/ctf_db

# CTF Platform
WRITEUP_PASSWORD=admin

# Optional: PostgreSQL (if using docker-compose)
POSTGRES_USER=ctf_user
POSTGRES_PASSWORD=ctf_password
POSTGRES_DB=ctf_db
